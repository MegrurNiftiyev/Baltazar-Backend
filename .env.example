# ── Baltazar Backend — Environment Variables ──
# Copy this file to .env.development / .env.production
# and fill in the values.

NODE_ENV=development
# PORT - DO NOT set this in .env.production. Render/Railway/Heroku inject their
# own PORT automatically; only set it here for local development override.
PORT=3000
LOG_LEVEL=debug

# JWT — minimum 32 characters each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Firebase Admin SDK credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=

# Payment Gateway Simulator
PAYMENT_GATEWAY_URL=http://localhost:4000
